.markdown-container {
    padding: 1.25rem;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    max-height: 70vh;
    overflow-y: auto;
}

/* ── Headers ── */
.markdown-body h1 {
    font-size: 1.625rem;
    font-weight: 700;
    color: #032d60;
    margin: 1.5rem 0 0.75rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #0176d3;
}

.markdown-body h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: #032d60;
    margin: 1.25rem 0 0.625rem 0;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid #e5e7eb;
}

.markdown-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #181818;
    margin: 1rem 0 0.5rem 0;
}

.markdown-body h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #444444;
    margin: 0.875rem 0 0.375rem 0;
}

.markdown-body h5,
.markdown-body h6 {
    font-size: 0.875rem;
    font-weight: 600;
    color: #666666;
    margin: 0.75rem 0 0.25rem 0;
}

/* ── Paragraphs ── */
.markdown-body p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #333333;
    margin: 0.375rem 0;
}

.markdown-body .md-empty {
    color: #999999;
    font-style: italic;
}

/* ── Unordered Lists ── */
.markdown-body ul {
    margin: 0.5rem 0 0.5rem 1.5rem;
    padding: 0;
}

/* ── Ordered Lists ── */
.markdown-body ol {
    margin: 0.5rem 0 0.5rem 1.5rem;
    padding: 0;
}

.markdown-body li {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #333333;
    margin: 0.25rem 0;
}

/* ── Bold and Italic ── */
.markdown-body strong {
    font-weight: 700;
    color: #181818;
}

.markdown-body em {
    font-style: italic;
}

/* ── Inline code ── */
.markdown-body code {
    font-family: 'SF Mono', 'Consolas', 'Liberation Mono', 'Menlo', monospace;
    font-size: 0.8125rem;
    background-color: #f3f3f3;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    color: #c23934;
}

/* ── Code blocks ── */
.markdown-body pre {
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.375rem;
    overflow-x: auto;
    margin: 0.75rem 0;
    font-size: 0.8125rem;
    line-height: 1.5;
}

.markdown-body pre code {
    background-color: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
}

/* ── Tables ── */
.markdown-body .md-table-wrapper {
    overflow-x: auto;
    margin: 0.75rem 0;
    border: 1px solid #d8dde6;
    border-radius: 0.375rem;
    display: inline-block;
    max-width: 100%;
}

.markdown-body table {
    border-collapse: collapse;
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: normal;
}

.markdown-body thead {
    background-color: #032d60;
}

.markdown-body thead th {
    color: #ffffff;
    font-weight: 600;
    padding: 0.625rem 1.25rem 0.625rem 0.75rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 2px solid #0176d3;
}

.markdown-body tbody tr {
    border-bottom: 1px solid #e5e7eb;
}

.markdown-body tbody tr:nth-child(even) {
    background-color: #f7f9fb;
}

.markdown-body tbody tr:hover {
    background-color: #eef4fb;
}

.markdown-body tbody td {
    padding: 0.5rem 1.25rem 0.5rem 0.75rem;
    color: #333333;
    vertical-align: top;
}

.markdown-body tbody td:first-child {
    white-space: nowrap;
    font-weight: 600;
    color: #181818;
}

.markdown-body tbody td code {
    font-size: 0.75rem;
}

/* ── Blockquotes ── */
.markdown-body blockquote {
    margin: 0.75rem 0;
    padding: 0.625rem 1rem;
    border-left: 4px solid #0176d3;
    background-color: #f7f9fb;
    border-radius: 0 0.25rem 0.25rem 0;
}

.markdown-body blockquote p {
    color: #555555;
    margin: 0.25rem 0;
}

/* ── Horizontal rule ── */
.markdown-body hr {
    border: none;
    border-top: 1px solid #d8dde6;
    margin: 1rem 0;
}

/* ── Scrollbar ── */
.markdown-container::-webkit-scrollbar {
    width: 6px;
}

.markdown-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

.markdown-container::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
}

.markdown-container::-webkit-scrollbar-thumb:hover {
    background: #a1a1a1;
}

/* ── Table wrapper scrollbar ── */
.markdown-body .md-table-wrapper::-webkit-scrollbar {
    height: 6px;
}

.markdown-body .md-table-wrapper::-webkit-scrollbar-track {
    background: #f1f1f1;
}

.markdown-body .md-table-wrapper::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
}